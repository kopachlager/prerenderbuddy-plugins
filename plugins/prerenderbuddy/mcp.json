{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "prerenderbuddy": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@prerenderbuddy/mcp@0.2.0"
      ],
      "env": {
        "PRERENDER_BUDDY_API_KEY": "${PRERENDER_BUDDY_API_KEY}"
      }
    }
  }
}
